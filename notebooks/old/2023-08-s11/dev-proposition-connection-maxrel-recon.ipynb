   "source": [
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 53,
   "id": "ebd3948a",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "0.7068583470577035"
      ]
     },
     "execution_count": 53,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "a = np.array([1, 0.1])\n",
    "c = np.array([np.pi/4, -np.pi/4])\n",
    "\n",
    "a.dot(c)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 75,
   "id": "d97ba67c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "a=[1.  0.1]  |  c=[ 0.78539816 -0.78539816]\n",
      "u=[ 0.81962615 -0.57289875]\n",
      "-0.10580253106194393\n"
     ]
    }
   ],
   "source": [
    "u = np.random.randn(2) \n",
    "u /= np.linalg.norm(u)\n",
    "\n",
    "ru = a.dot(u) * c.dot(u)\n",
    "r = a.dot(c)\n",
    "\n",
    "print(f\"a={a}  |  c={c}\")\n",
    "print(f\"u={u}\")\n",
    "\n",
    "print(r * ru - ru**2)"
   ]
  },
